<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#328E6E"
    >


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="25dp"
        android:gravity="center_horizontal">


        <TextView
            android:id="@+id/questionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Who won the Ballon Dor 2007/2008? "

            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"
            android:textColor="#000000" />
        <!-- ⏲️ المؤقت تحت السؤال وبالمنتصف -->
        <TextView
            android:id="@+id/timerTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="30"
            android:textSize="26sp"
            android:textColor="#FF0000"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btoon1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Messi"
            android:textColor="#67AE6E"
            android:backgroundTint="#E1EEBC"

            android:layout_marginBottom="30dp" />

        <Button
            android:id="@+id/btoon2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Neymar"
            android:textColor="#67AE6E"
            android:backgroundTint="#E1EEBC"
            android:layout_marginBottom="30dp" />

        <Button
            android:id="@+id/btoon3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Slimani"
            android:textColor="#67AE6E"
            android:backgroundTint="#E1EEBC"
            android:layout_marginBottom="30dp" />

        <Button
            android:id="@+id/btoon4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Antony"
            android:textColor="#67AE6E"
            android:backgroundTint="#E1EEBC"
            android:layout_marginBottom="30dp" />

        <Button
            android:id="@+id/btoon5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CR7 Ronaldo"
            android:textColor="#67AE6E"
            android:backgroundTint="#E1EEBC"
            android:layout_marginBottom="30dp" />
        <Button
            android:id="@+id/Next4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Next"
            android:textColor="#FFFFFF"
            android:backgroundTint="#4CAF50"
            android:layout_marginTop="16dp"
            android:layout_gravity="center"/>


    </LinearLayout>
</ScrollView>
